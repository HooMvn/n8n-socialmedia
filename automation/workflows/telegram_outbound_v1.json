{
  "name": "ENGAGE__OUTBOUND__TELEGRAM__V1",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "risheh-engage-outbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Outbound Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const secret = $json.headers?.['x-automation-secret'];\nif (!secret || secret !== $env.RISHEH_AUTOMATION_SECRET) throw new Error('invalid automation secret');\nconst e = $json.body ?? $json;\nif (e.event_type !== 'message.outbound.requested') throw new Error('unsupported event type');\nreturn [{json:e}];"
      },
      "id": "validate",
      "name": "Validate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.RISHEH_API_BASE_URL + '/api/v1/automation/outbound/' + $json.aggregate_id + '/delivery-context'}}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-Automation-Secret", "value": "={{$env.RISHEH_AUTOMATION_SECRET}}"}]},
        "options": {}
      },
      "id": "context",
      "name": "Resolve Delivery Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 0]
    },
    {
      "parameters": {
        "jsCode": "if ($json.channel !== 'telegram') throw new Error('unsupported channel'); return [{json:$json}];"
      },
      "id": "channel",
      "name": "Validate Telegram Channel",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ chat_id: $json.target_external_user_id, text: $json.body }) }}",
        "options": {}
      },
      "id": "send",
      "name": "Telegram Send Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [910, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.RISHEH_API_BASE_URL + '/api/v1/automation/outbound/callback'}}",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-Automation-Secret", "value": "={{$env.RISHEH_AUTOMATION_SECRET}}"}]},
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ outbound_message_id: $('Resolve Delivery Context').item.json.outbound_message_id, idempotency_key: $('Resolve Delivery Context').item.json.idempotency_key, status: 'sent', external_message_id: String($json.result?.message_id ?? ''), error_code: null, error_message: null }) }}",
        "options": {}
      },
      "id": "callback",
      "name": "Outbound Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 0]
    },
    {
      "parameters": {"respondWith": "json", "responseBody": "={{ { accepted: true } }}", "options": {}},
      "id": "respond",
      "name": "Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1370, 0]
    }
  ],
  "connections": {
    "Outbound Webhook": {"main": [[{"node": "Validate Event", "type": "main", "index": 0}]]},
