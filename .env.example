# Risheh Engage — local environment example
# Never commit real secrets.

# App / Auth
ENVIRONMENT=development
APP_SECRET_KEY=replace-with-a-long-random-secret
JWT_ISSUER=risheh-engage
JWT_AUDIENCE=risheh-engage-api
JWT_ACCESS_MINUTES=60
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://engage:engage@localhost:5432/engage

# Redis
REDIS_URL=redis://localhost:6379/0

# n8n delivery
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
N8N_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
N8N_PUBLISH_WEBHOOK_URL=http://localhost:5678/webhook/risheh-engage-publish
N8N_OUTBOUND_WEBHOOK_URL=http://localhost:5678/webhook/risheh-engage-outbound

# n8n environment aliases used by importable workflows
RISHEH_API_BASE_URL=http://api:8000
RISHEH_AUTOMATION_SECRET=replace-with-the-same-n8n-webhook-secret
RISHEH_WORKSPACE_ID=

# Outbox worker
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_SECONDS=120
OUTBOX_POLL_SECONDS=3

# Telegram Provider / Channel Adapter
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_INBOUND_WEBHOOK_URL=http://localhost:5678/webhook/risheh-engage-telegram-inbound

# AI provider — OpenAI-compatible Chat Completions endpoint
AI_PROVIDER=openai-compatible
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

# Meta / Instagram adapter — next provider
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Storage — future media asset layer
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
LOG_LEVEL=INFO
